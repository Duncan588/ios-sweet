-#define PLATFORM_PANIC_LOG_DISABLED
+/*
+ * 0089: sweet ADTs have no iBoot "pram" node, so check_for_panic_log()
+ * left gPanicBase == 0: debug_log_init() refused the panic buffer and
+ * PE_init_panicheader() subsequently tripped its assert(gPanicBase != 0)
+ * inside a nested panic that dies in panic_stop(): the black-box freezes
+ * seen on boot#17/#18 right after the "PE_arm_debug_enable_trace" beats.
+ * Map the panic log to the tail of the ABL ramdump-framebuffer
+ * reservation (0xaf000000..0xb0000000): it is unused after the boot
+ * splash, it stays below the kernel physBase (0xb0000000) so no later VM
+ * allocation can ever take it, and the chosen block is page-aligned.
+ * Same escape hatch BCM2837.h uses for its panic region (0x3c0fc000).
+ */
+#define PLATFORM_PANIC_LOG_PADDR        0xaff80000ULL
+#define PLATFORM_PANIC_LOG_SIZE         0x00080000
 #endif /* ! ASSEMBLER */
 
