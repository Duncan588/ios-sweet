+/*
+ * P0095 Phase A: bring the SWEET-USB gadget + raw-frame UDP log pump up
+ * before bsd_init() (osfmk/kern/startup.c hook, kernel_bootstrap).
+ *
+ * Design doc: docs/P0095_UNATTENDED_DESIGN.md, Q1/Q2.
+ *
+ * The venus death wall sits after mac_policy_initbsd() and long before
+ * the existing mountroot probe (sweet_ufs_init -> sweet_usb_probe), so
+ * every previous observation round (boot#22-25) died with the sweetusb
+ * driver never having run and zero bytes captured. This hook runs the
+ * gadget bring-up in bsd/dev/sweet_usb.c minus the ue0/DLIL/socket parts
+ * (those kernel interfaces do not exist before bsd_init) and starts the
+ * raw-frame UDP pump that ships the console ring - including everything
+ * logged before the wall - to the listener described by
+ * tools/sweet-usbnet.sh. The mountroot path keeps its full ue0 flow
+ * (Phase B, unchanged for sweet) and is skipped here only when Phase A
+ * already brought the same controller up.
+ *
+ * Gating per design/boot default: Phase A runs only when the boot-arg
+ * sweetusb=2 is given; without it the boot behaves exactly like P0094
+ * and earlier (the comparison round captures nothing). Compile-time the
+ * file is armed by ARM64_BOARD_CONFIG_SWEET like the rest of the series.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/misc_protos.h>
+#include <pexpert/pexpert.h>
+
+extern void sweet_usb_gadget_early(void);       /* bsd/dev/sweet_usb.c */
+
+void
+sweet_usb_early_start(void)
+{
+	int enabled = 0;
+
+	(void) PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
+	if (enabled != 2) {
+		/* Default: Phase A stays off, boot identical to previous
+		 * kernels unless the launcher asks for the early gadget. */
+		return;
+	}
+	printf("P0095: early usb start (sweetusb=2) in kernel_bootstrap, "
+	    "before bsd_init\n");
+	sweet_usb_gadget_early();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
