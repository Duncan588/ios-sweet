--- /dev/null
+++ b/bsd/dev/sweet_wdt.c
@@ -0,0 +1,135 @@
+/*
+ * P0095: venus hardware watchdog backstop (0x17c10000, msm-watchdog map).
+ *
+ * Design doc: docs/P0095_UNATTENDED_DESIGN.md, Q3/Q4 (all values re-checked
+ * against the [VERIFIED] table before being written here).
+ *
+ * The Xiaomi Mi 11 (venus) DTB maps qcom,wdt@17c10000, compatible
+ * "qcom,msm-watchdog", reg 0x17c10000/0x1000, WDT_HZ 32765. Register map
+ * re-verified against MiCode/Xiaomi_Kernel_OpenSource branch venus-r-oss,
+ * drivers/soc/qcom/qcom_soc_wdt.c:
+ *   WDT0_RST 0x04 / WDT0_EN 0x08 / WDT0_STS 0x0c / WDT0_BARK_TIME 0x10 /
+ *   WDT0_BITE_TIME 0x14; pet = write 1 to RST, enable = write BIT(0) to EN.
+ * (The kpss-wdt map - RST 0x38/EN 0x40 - is a different compatible and was
+ * already ruled out in the design doc; do not "simplify" this back.)
+ *
+ * The stock kernel arms bark at 20 s with a bite ~10 s later, but XNU has
+ * no handler for the bark SPI0, so BARK is programmed far beyond BITE and
+ * the only watchdog exit is the hardware bite: any wedge stops being fed
+ * and the SoC resets to recovery within 60 s, giving an unattended round
+ * its reset even without USB or serial evidence. The bite is distinguish-
+ * able from an orderly reset via bootinfo.pureason bit0 (wdog).
+ *
+ * Feeding is triple-braced (P0095):
+ *   1. every sweet_early_mark() stage (osfmk/arm64/sweet_early.c)
+ *   2. the P0092/P0094 bsd_init mark sites (bsd/kern/bsd_init.c)
+ *   3. this dedicated 15 s feed thread
+ * plus the sweet USB event/log threads. Boot-arg sweetwdt=0 turns the
+ * whole thing off; it is on by default, so the official 17-argument
+ * cmdline needs no change.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/types.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/misc_protos.h>
+#include <pexpert/pexpert.h>
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+
+#define SW_WDT_BASE     0x17C10000ULL
+#define SW_WDT_SIZE     0x1000
+#define SW_WDT_RST      0x04
+#define SW_WDT_EN       0x08
+#define SW_WDT_STS      0x0c
+#define SW_WDT_BARK     0x10
+#define SW_WDT_BITE     0x14
+#define SW_WDT_HZ       32765           /* qcom_soc_wdt.c, venus-r-oss */
+#define SW_WDT_BITE_MS  60000           /* design Q4: 60 s bite */
+#define SW_WDT_FEED_MS  15000           /* design Q4: feed every 15 s */
+
+static volatile uint32_t *sw_wdt;       /* mapped once, stays forever */
+static int sw_wdt_chan;                 /* feed thread sleep channel  */
+
+/* Any context, no locks: one 32-bit store matches the stock pet. */
+void
+sweet_wdt_pet(void)
+{
+	if (!sw_wdt) {
+		return;
+	}
+	sw_wdt[SW_WDT_RST / 4] = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Reprogram the watchdog with bark>>bite parameters (shim already armed
+ * it 60 s before the jump, so a no-op padding is safe). Sequence per
+ * design Q4 / qcom_soc_wdt.c: EN=0 - RST=1 - BARK - BITE - EN=1 - RST=1.
+ */
+static void
+sweet_wdt_reinit(void)
+{
+	uint32_t bite = (uint32_t)((uint64_t)SW_WDT_BITE_MS * SW_WDT_HZ / 1000);
+
+	sw_wdt[SW_WDT_EN / 4] = 0;
+	sw_wdt[SW_WDT_RST / 4] = 1;
+	sw_wdt[SW_WDT_BARK / 4] = 0xFFFFFFFEu;  /* bark never fires first */
+	sw_wdt[SW_WDT_BITE / 4] = bite;
+	sw_wdt[SW_WDT_EN / 4] = 1;              /* BIT(0) enable only */
+	sw_wdt[SW_WDT_RST / 4] = 1;             /* restart the counter */
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("P0095: wdt armed bite=%ums bark=0x%x en=0x%x sts=0x%x\n",
+	    SW_WDT_BITE_MS, sw_wdt[SW_WDT_BARK / 4], sw_wdt[SW_WDT_EN / 4],
+	    sw_wdt[SW_WDT_STS / 4]);
+}
+
+static void
+sweet_wdt_feed(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		uint64_t deadline;
+
+		clock_interval_to_deadline(SW_WDT_FEED_MS / 1000, NSEC_PER_SEC,
+		    &deadline);
+		(void) assert_wait_deadline(&sw_wdt_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		sweet_wdt_pet();
+	}
+}
+
+/* kernel_bootstrap hook (osfmk/kern/startup.c, right before bsd_init). */
+void
+sweet_wdt_early_init(void)
+{
+	int on = 1;
+	vm_offset_t va;
+	thread_t thread;
+
+	(void) PE_parse_boot_argn("sweetwdt", &on, sizeof(on));
+	if (!on) {
+		printf("P0095: sweetwdt=0, hardware WDT backstop disabled\n");
+		return;
+	}
+	va = ml_io_map((vm_offset_t)SW_WDT_BASE, SW_WDT_SIZE);
+	if (va == 0) {
+		printf("P0095: wdt map failed for 0x%llx\n",
+		    (unsigned long long)SW_WDT_BASE);
+		return;
+	}
