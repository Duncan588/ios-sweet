+/*
+ * P0095 Phase A: raw-frame UDP pump. The console ring (bsd/dev/sweet_ufs.c
+ * hook in _cnputs) is drained to the listener described by
+ * tools/sweet-usbnet.sh with self-built Ethernet/IPv4/UDP headers - no
+ * ifnet, no DLIL, no sockets, since none of that exists before bsd_init.
+ * Header constants are the file's own truth values:
+ *   host MAC = the ECM iMACAddress (:354 "02005E77EE01"),
+ *   phone MAC = ud_phone_mac (:356),
+ *   phone 192.168.7.2 (:691), host 192.168.7.1 (:826), UDP/5140 (:825).
+ * Framing follows the existing ECM bulk-IN TX conventions (:536-559:
+ * a frame of a multiple of 512 bytes gets one pad byte). The pump itself
+ * never prints - whatever it says would fill the ring it drains.
+ */
+#define SWEET_UDP_LOG_PORT      5140
+#define SWEET_UDP_LOG_CHUNK     1200
+
+static const uint8_t ud_host_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x01 };
+
+static uint16_t
+ud_pump_checksum16(const uint8_t *p, uint32_t len)
+{
+	uint32_t sum = 0;
+
+	for (uint32_t i = 0; i < len; i += 2) {
+		sum += ((uint32_t)p[i] << 8) | ((i + 1 < len) ? p[i + 1] : 0);
+	}
+	while (sum > 0xffff) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)(~sum);
+}
+
+static void
+ud_pump_send(const uint8_t *payload, uint32_t len, uint32_t frag_id)
+{
+	uint8_t *f = (uint8_t *)(ud.dma + UD_TX);
+	uint32_t flen = 14u + 20u + 8u + len;
+	uint16_t sum;
+	uint32_t ulen = 8u + len;
+
+	memcpy(f, ud_host_mac, ETHER_ADDR_LEN);
+	memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	f[12] = 0x08;                   /* EtherType IPv4 */
+	f[13] = 0x00;
+	f[14] = 0x45;                   /* v4, IHL 20 */
+	f[15] = 0;
+	f[16] = (uint8_t)(flen >> 8);
+	f[17] = (uint8_t)flen;
+	f[18] = (uint8_t)(frag_id >> 8);
+	f[19] = (uint8_t)frag_id;
+	f[20] = 0x40;                   /* DF, no fragments */
+	f[21] = 0;
+	f[22] = 64;
+	f[23] = 17;                     /* proto UDP */
+	f[24] = 0;
+	f[25] = 0;                      /* checksum appended below */
+	f[26] = 0xc0; f[27] = 0xa8; f[28] = 0x07; f[29] = 0x02;  /* self */
+	f[30] = 0xc0; f[31] = 0xa8; f[32] = 0x07; f[33] = 0x01;  /* host */
+	sum = ud_pump_checksum16(f + 14, 20);
+	f[24] = (uint8_t)(sum >> 8);
+	f[25] = (uint8_t)sum;
+	f[34] = (uint8_t)(SWEET_UDP_LOG_PORT >> 8);
+	f[35] = (uint8_t)SWEET_UDP_LOG_PORT;
+	f[36] = (uint8_t)(SWEET_UDP_LOG_PORT >> 8);
+	f[37] = (uint8_t)SWEET_UDP_LOG_PORT;
+	f[38] = (uint8_t)(ulen >> 8);
+	f[39] = (uint8_t)ulen;
+	f[40] = 0;
+	f[41] = 0;                      /* UDP checksum 0: allowed over v4 */
+	memcpy(f + 42, payload, len);
+	/* 512-multiple frame closes with one pad byte (:551-553). */
+	if ((flen % 512) == 0) {
+		f[flen++] = 0;
+	}
+	ud.tx_busy = true;
+	ud.tx_frames++;
+	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)flen, TRBCTL_NORMAL);
+}
+
+/* Same pattern as ud_sleep_ms, own wait channel (pumps + event thread
+ * sleep independently). Design R1/R2 accepted: clock_init already ran. */
+static void
+ud_pump_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void) assert_wait_deadline(&ud.pump_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ud_pump_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static uint8_t chunk[SWEET_UDP_LOG_CHUNK];
+	uint64_t pos = sweet_log_position();
+	uint32_t pump_ticks = 0;
+
+	/* Start 64 KiB back so the pre-wall boot lines are included. */
+	pos = pos > 65536 ? pos - 65536 : 0;
+	for (;;) {
+		uint32_t n;
+
+		/* While the TRB is pending (tx_busy) the ring holds the data;
+		 * only drain when the endpoint is free. */
+		while (ud.configured && !ud.tx_busy &&
+		    (n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			ud_pump_send(chunk, n, (uint32_t)pos);
+		}
+		if ((++pump_ticks % 150) == 0) {
+			sweet_wdt_pet();        /* P0095: 15 s WDT feed */
+		}
+		ud_pump_sleep_ms(100);
+	}
+}
+
+/*
+ * P0095 Phase A entry (from bsd/dev/sweet_usb_early.c, before bsd_init):
+ * echo power/clock state read-only (venus clocks stay as ABL configured
+ * them; 0x088e2000 is the EUD manager on venus and is never touched), run
+ * the same controller bring-up as the mountroot path, start the pump.
+ * Everything here fails soft: failure means "no early log", never death.
+ */
+void
+sweet_usb_gadget_early(void)
+{
+	vm_offset_t gcc, dwc;
+	uint32_t gdscr, master, cfgnoc;
+	thread_t thread;
+
+	if (ud_early_up || ud_early) {
+		return;
+	}
+	gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (gcc == 0) {
+		printf("P0095: early GCC map failed\n");
+		return;
+	}
+	gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	master = usb_rd(gcc, usb_cbcr[0].off);
+	cfgnoc = usb_rd(gcc, usb_cbcr[3].off);
+	printf("P0095: early usb GDSCR 0x%08x master 0x%08x cfg-noc 0x%08x (echo only)\n",
+	    gdscr, master, cfgnoc);
+	if (!(gdscr & (1u << 31)) || (master & CBCR_CLK_OFF) || (cfgnoc & CBCR_CLK_OFF)) {
+		printf("P0095: early: controller unpowered/unclocked; no early log\n");
+		return;
+	}
+	dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("P0095: early DWC3 map failed\n");
+		return;
+	}
+
+	ud_early = 1;
+	sweet_usb_gadget_start(dwc);
+	if (kernel_thread_start(ud_pump_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
+		ud_early_up = 1;
+		printf("P0095: early usb up, raw-frame pump running\n");
 	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
