# P0093: verbatim venus port of the topaz 0088 gpt-watchdog, regenerated
# against the venus tree (bsd/dev/sweet_ufs.c differs slightly from topaz).
#
# WHY THIS IS MANDATORY: userdata now carries the iOS root image
# (mkiosroot.sh; ufsrw=1 activates the real write path), so the LUN0 GPT is
# the only thing between a stray write and a permanently unbootable phone.
# It records both header copies (primary header CRC at b+16, backup LBA at
# b+32, entry-region CRC32 at b+88, backup header CRC read back at b+16),
# refuses any write to LBA 0..5 or the backup header tail window, and a
# watchdog thread (started from sweet_ufs_init next to sweet_log_start())
# re-reads both headers every 10 s and panics with old/new values and
# uptime the moment they differ or a read fails.

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -271,6 +271,21 @@
 	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * P0093: on venus the userdata partition now carries the iOS root image, so
+ * the LUN0 GPT is the only thing standing between a stray write and an
+ * unbootable phone (no stock flasher left to restore it). Remember both GPT
+ * copies (primary header CRC, entry-region CRC32, backup header CRC) and
+ * fence them off from every write; a watchdog thread re-reads them every
+ * 10 s and panics the moment they change. Must stay a verbatim port of the
+ * topaz 0088 patch.
+ */
+static uint64_t gpt_alt;                /* backup header LBA (last LBA of LUN0) */
+static uint32_t gpt_hcrc, gpt_ecrc, gpt_bhcrc;
+static int gpt_chan;
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 /*
  * WRITE(10) of count device blocks from the bounce buffer to lba. The range
  * must lie inside the partition: this is the only place data goes out.
@@ -280,7 +295,10 @@
 {
 	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
 	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
-	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
+	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX ||
+	    /* P0093: never reach LBA 0 (protective MBR/primary GPT header) nor
+	     * the backup GPT header and its tail; that is the whole phone. */
+	    lba < 6 || (gpt_alt && lba + count - 1 >= gpt_alt - 4)) {
 		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
 		return EPERM;
 	}
@@ -313,6 +331,13 @@
 	}
 	uint64_t entry_lba;
 	uint32_t nent, esz;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* P0093: remember the primary header CRC, the backup header LBA and
+	 * the entry-region CRC32 word for the watchdog. */
+	memcpy(&gpt_hcrc, b + 16, 4);
+	memcpy(&gpt_alt, b + 32, 8);
+	memcpy(&gpt_ecrc, b + 88, 4);
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 	memcpy(&entry_lba, b + 72, 8);
 	memcpy(&nent, b + 80, 4);
 	memcpy(&esz, b + 84, 4);
@@ -347,6 +372,14 @@
 		}
 		su.first_block = first;
 		su.nblocks = last - first + 1;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/* P0093: also remember the backup header CRC once found. */
+		if (ufs_read_blocks(gpt_alt, 1) == 0 && memcmp(b, "EFI PART", 8) == 0) {
+			memcpy(&gpt_bhcrc, b + 16, 4);
+		}
+		printf("SWEET UFS: P0093 GPT LUN0 hcrc %#x ecrc %#x backup@%#llx hcrc %#x\n",
+		    gpt_hcrc, gpt_ecrc, gpt_alt, gpt_bhcrc);
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 		return 0;
 	}
 	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
@@ -583,6 +616,43 @@
 	.d_type       = D_DISK,
 };
 
+/* P0093: re-read and compare both GPT header copies every 10 s; panic the
+ * moment either changes (or a read fails) - userdata carries the iOS root,
+ * a destroyed GPT is an unbrickable phone. */
+static void
+sweet_gpt_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t start = mach_absolute_time();
+	for (;;) {
+		uint64_t deadline;
+		clock_interval_to_deadline(10, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&gpt_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		uint32_t h = 0, e = 0, bh = 0;
+		bool ok;
+		lck_mtx_lock(&sweet_ufs_lock);
+		ok = ufs_read_blocks(1, 1) == 0 && memcmp(b, "EFI PART", 8) == 0;
+		if (ok) {
+			memcpy(&h, b + 16, 4);
+			memcpy(&e, b + 88, 4);
+		}
+		if (ok && gpt_bhcrc && ufs_read_blocks(gpt_alt, 1) == 0) {
+			if (memcmp(b, "EFI PART", 8) == 0) {
+				memcpy(&bh, b + 16, 4);
+			}
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (!ok || h != gpt_hcrc || e != gpt_ecrc || (gpt_bhcrc && bh != gpt_bhcrc)) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+			panic("SWEET UFS: P0093 GPT LUN0 CHANGED after %llu s: primary %s hcrc %#x/%#x ecrc %#x/%#x backup hcrc %#x/%#x",
+			    ns / NSEC_PER_SEC, ok ? "present" : "MISSING", h, gpt_hcrc, e, gpt_ecrc, bh, gpt_bhcrc);
+		}
+	}
+}
+
 static int
 sweet_ufs_init(void)
 {
@@ -673,6 +743,13 @@
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
 	sweet_log_start();
 	sweet_sample_start();
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* P0093: watch the LUN0 GPT copies from now on. */
+	thread_t gpt_thread;
+	if (kernel_thread_start(sweet_gpt_watch, NULL, &gpt_thread) == KERN_SUCCESS) {
+		thread_deallocate(gpt_thread);
+	}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
 	sweet_keys_init();
 	sweet_touch_init();
