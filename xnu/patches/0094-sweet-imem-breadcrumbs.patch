# P0094: venus IMEM restart-reason breadcrumbs (XNU writes + top-level crash
# path instrumentation).
#
# The Xiaomi Mi 11 (venus) device tree maps qcom,msm-imem@146bf000 with the
# restart_reason subnode at offset 0x65c, so breadcrumbs live at
# 0x146bf65c (code) / 0x146bf660 (sequence) / 0x146bf664 (previous code).
# The 0x146AA65C base everyone used before is the SM7150 ("sweet") IMEM and
# caused the historical data aborts on venus - it must never be written
# again. Android lost every read-back channel (/dev/mem absent, driver
# unbound), so the venus shim reads and prints the previous boot's triple
# at the earliest moment of the next boot (shim.c P0094 line).
#
# XNU side: sweet_early.c gains a lazy one-page ml_io_map() helper
# (sweet_imem_init, called from PE_init_platform right where the P0089
# panic-log mapping happens, so kernel_map is already usable) and
# sweet_imem_mark(code): an idempotent, lock-free 32-bit write triplet for
# arbitrary crash contexts. Marks (each a distinct literal):
#   0x9401 kernel_bootstrap entry
#   0x9402 static trust cache done
#   0x9403 bsd_init enter
#   0x9404 bsd_init done
#   0x9405 PEHaltRestartInternal entry (type in low 8 bits)
#   0x9406 halt_all_cpus entry (reboot flag in low 8 bits)
#   0x9407 panic_trap_to_debugger entry (before any freeze/stall path)
#   0x9408 sleh_synchronous non-SVC exception entry
#   0x9409 sleh_serror entry
# All increments are inside #if defined(ARM64_BOARD_CONFIG_SWEET).

--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -230,4 +230,67 @@
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
+
+/*
+ * 0094: venus IMEM restart-reason breadcrumbs. The Xiaomi Mi 11 device
+ * tree maps qcom,msm-imem@146bf000 and its restart_reason subnode sits
+ * at offset 0x65c, so the words are at 0x146bf65c (code), 0x146bf660
+ * (sequence) and 0x146bf664 (previous code). XNU writes a distinct code
+ * at every boot stage and crash/reboot funnel; the shim prints the
+ * previous boot's triple at the very start of the next boot, which is
+ * the only read-back channel left (Android lost /dev/mem and the
+ * driver never binds). 0x146AA65C is the old SM7150 ("sweet") IMEM and
+ * caused the historical data aborts on venus - never write there.
+ *
+ * Mapping is done by sweet_imem_init() from PE_init_platform (same spot
+ * as the P0089 panic-log mapping, so kernel_map is usable); earlier
+ * calls into sweet_imem_mark() are no-ops until it succeeds.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define SWEET_IMEM_PADDR        0x146bf000ULL
+#define SWEET_IMEM_SIZE         0x1000
+#define SWEET_IMEM_MARK_OFF     0x65c
+
+static volatile uint32_t *sweet_imem;           /* VA of 0x146bf65c */
+static uint32_t sweet_imem_prev, sweet_imem_seq;
+
+void
+sweet_imem_init(void)
+{
+	if (sweet_imem) {
+		return;
+	}
+	vm_offset_t va = ml_io_map((vm_offset_t)SWEET_IMEM_PADDR, SWEET_IMEM_SIZE);
+	if (!va) {
+		printf("P0094: IMEM map failed for 0x%llx\n",
+		    (unsigned long long)SWEET_IMEM_PADDR);
+		return;
+	}
+	sweet_imem = (volatile uint32_t *)(uintptr_t)(va + SWEET_IMEM_MARK_OFF);
+	printf("P0094: IMEM mapped va=0x%llx, marks at +0x%x\n",
+	    (unsigned long long)va, SWEET_IMEM_MARK_OFF);
+}
+
+/*
+ * Idempotent, side-effect free, called from arbitrary crash paths (no
+ * allocations or locks). The reader watches the sequence word so a
+ * passed torn write is never trusted.
+ */
+void
+sweet_imem_mark(unsigned int code)
+{
+	if (!sweet_imem) {
+		return;
+	}
+	sweet_imem[2] = sweet_imem_prev;
+	__builtin_arm_dsb(0xf);
+	sweet_imem[0] = code;
+	sweet_imem[1] = ++sweet_imem_seq;       /* commit flag written last */
+	__builtin_arm_dsb(0xf);
+	sweet_imem_prev = code;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 #endif /* SWEET */
